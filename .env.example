# Backend
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/job_orchestrator
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Worker lease and heartbeat (seconds)
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_TIMEOUT_SECONDS=5

# Scheduler loop interval (seconds)
SCHEDULER_INTERVAL_SECONDS=2

# Job submission limits and retry policy
JOB_DEFAULT_MAX_ATTEMPTS=5
JOB_MAX_PAYLOAD_BYTES=65536
JOB_QUEUE_MAX_AGE_SECONDS=3600
MAX_IN_FLIGHT_JOBS_PER_USER=200
RETRY_BASE_SECONDS=2.0
RETRY_MAX_SECONDS=1800.0
RETRY_JITTER_RATIO=0.25

# Notification delivery
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5
NOTIFICATION_SIGNING_SECRET=local-development-secret-change-me

# Demo job submitter (scripts/seed.py and scripts/submit_jobs.py)
DEMO_TARGET_URL=http://localhost:8000
DEMO_USER_ID=demo-user
DEMO_ROUNDS=3

# Test database (used by pytest; created automatically if missing)
TEST_DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/job_orchestrator_test

# PostgreSQL container (local development only, not for production)
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=job_orchestrator

# Docker Compose host port mappings (change if a port is already in use)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
